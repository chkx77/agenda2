rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /propietarios/{uid} {
      // This document must contain public profile/configuration only.
      allow read: if true;
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['config']);
      allow delete: if owner(uid);
      match /turnos/{id} { allow read: if owner(uid); allow write: if false; }
      match /ocupados/{id} { allow read: if true; allow write: if false; }
      match /bloqueos/{date} { allow read: if true; allow write: if owner(uid); }
      match /locks/{id} { allow read, write: if false; }
    }
  }
}
